<Window x:Class="TaskTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskTool"
        xmlns:m="clr-namespace:TaskTool.Models"
        Title="TaskTool" Width="1000" Height="660" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista ===== -->
        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Busca (títulos, descrições e anotações, ativas e concluídas) -->
                <Grid Margin="0,0,0,10">
                    <!-- O tema Fluent já mostra um "X" para limpar quando a caixa tem foco; Esc também limpa. -->
                    <TextBox x:Name="BuscaBox" Padding="34,7,10,7" TextChanged="BuscaBox_TextChanged" KeyDown="BuscaBox_KeyDown"
                             ToolTip="Busca em títulos, descrições e anotações (ativas e concluídas). Esc limpa." />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False"
                               Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=BuscaBox}" Margin="36,0,0,0"
                               Text="Buscar (Ctrl+F)" />
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="Abas" Orientation="Horizontal" Margin="4,0,0,8">
                        <RadioButton x:Name="AbaAtivas" Content="Ativas" Style="{StaticResource TabRadio}" IsChecked="True" Checked="Aba_Checked" />
                        <RadioButton x:Name="AbaConcluidas" Content="Concluídas" Style="{StaticResource TabRadio}" Checked="Aba_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="ResultadosTxt" Margin="4,4,0,12" FontSize="13" Foreground="{StaticResource FgMuted}" Visibility="Collapsed" />
                </Grid>

                <Grid x:Name="NovaArea" Grid.Row="2" Margin="0,0,0,10">
                    <TextBox x:Name="NovaBox" KeyDown="NovaBox_KeyDown" Padding="10,7" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NovaBox}" Text="Nova tarefa… (Enter)" />
                </Grid>

                <ListBox x:Name="Lista" Grid.Row="3" SelectionChanged="Lista_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Tarefa}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Accent}" Margin="6,2,0,0" ToolTip="Em foco"
                                                   Visibility="{Binding Foco, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                    </DockPanel>
                                    <TextBlock x:Name="Sub" Text="{Binding Subtitulo}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource FgMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Atrasada}" Value="True">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" x:Name="ListaVazia" Text="Nada por aqui." Foreground="{StaticResource FgMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasItems, ElementName=Lista, Converter={StaticResource BoolVisInv}}" />
            </Grid>
        </Border>

        <!-- ===== Detalhe ===== -->
        <TextBlock Grid.Column="1" Text="Selecione uma tarefa" Foreground="{StaticResource FgMuted}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding SelectedItem, ElementName=Lista, Converter={StaticResource BoolVisInv}}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedItem, ElementName=Lista, Converter={StaticResource BoolVis}}">
            <StackPanel x:Name="Detalhe" Margin="32,22,32,28" DataContext="{Binding SelectedItem, ElementName=Lista}">

                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         TextWrapping="Wrap" Padding="8,6" />

                <!-- Status + ações -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                        <RadioButton Style="{StaticResource StatusRadio}" Content="A fazer" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.AFazer}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=AFazer}" />
                        <RadioButton Style="{StaticResource StatusRadio}" Content="Fazendo" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.Fazendo}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Fazendo}" />
                        <RadioButton Style="{StaticResource StatusRadio}" Content="Aguardando" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.Aguardando}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Aguardando}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"
                               Visibility="{Binding IsConcluida, Converter={StaticResource BoolVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0"
                                    Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                            <Button Style="{StaticResource TextButton}" Click="Focar_Click" ToolTip="Fixar no topo do painel"
                                    Visibility="{Binding Foco, Converter={StaticResource BoolVisInv}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Focar" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="TirarFoco_Click" Foreground="{StaticResource Accent}"
                                    Visibility="{Binding Foco, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77A;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Em foco · tirar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource AccentButton}" Click="Concluir_Click"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Concluir" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Click="Reabrir_Click" BorderThickness="1"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reabrir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Prazo e link -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Prazo (dd/mm)" />
                        <TextBox Text="{Binding PrazoTexto, UpdateSourceTrigger=LostFocus}" Padding="8,6" KeyDown="CampoSimples_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Link (chamado, PR, documento…)" />
                        <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="6,0,0,2"
                            Content="&#xE8A7;" ToolTip="Abrir link" Click="AbrirLink_Click" />
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Descrição" />
                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" MinHeight="110" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Padding="8,6" />

                <!-- Anotações (log) -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="Anotações" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NotaBox" Padding="8,6" KeyDown="NotaBox_KeyDown" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NotaBox}" Margin="10,0,0,0"
                               Text="O que aconteceu? (Enter para registrar)" />
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Registrar" Margin="6,0,0,0" Click="AdicionarNota_Click" />
                </Grid>

                <ItemsControl x:Name="Notas" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Anotacao}">
                            <Border x:Name="Bd" CornerRadius="5" Padding="10,7" Margin="0,2" Background="#0CFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Quando}" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap" />
                                    <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                            FontSize="11" Padding="6" Margin="6,-4,-4,-4" ToolTip="Excluir anotação"
                                            Click="ExcluirNota_Click" Opacity="0" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rodapé -->
                <Grid Margin="0,24,0,0">
                    <TextBlock x:Name="CriadaEmTxt" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Click="Excluir_Click"
                            Foreground="{StaticResource Danger}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Excluir tarefa" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
