<Window x:Class="TaskTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskTool"
        xmlns:m="clr-namespace:TaskTool.Models"
        Title="TaskTool" Width="1000" Height="660" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista ===== -->
        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Busca (títulos, descrições e anotações, ativas e concluídas) -->
                <Grid Margin="0,0,0,10">
                    <!-- O tema Fluent já mostra um "X" para limpar quando a caixa tem foco; Esc também limpa. -->
                    <TextBox x:Name="BuscaBox" Padding="34,7,10,7" TextChanged="BuscaBox_TextChanged" KeyDown="BuscaBox_KeyDown"
                             ToolTip="Busca em títulos, descrições e anotações (ativas e concluídas). Esc limpa." />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False"
                               Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=BuscaBox}" Margin="36,0,0,0"
                               Text="Buscar (Ctrl+F)" />
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="Abas" Orientation="Horizontal" Margin="4,0,0,8">
                        <RadioButton x:Name="AbaAtivas" Content="Ativas" Style="{StaticResource TabRadio}" IsChecked="True" Checked="Aba_Checked" />
                        <RadioButton x:Name="AbaConcluidas" Content="Concluídas" Style="{StaticResource TabRadio}" Checked="Aba_Checked" />
                        <RadioButton x:Name="AbaPauta" Content="Pauta" Style="{StaticResource TabRadio}" Checked="Aba_Checked"
                                     ToolTip="Tarefas com anotações marcadas para levar à reunião (ativas e concluídas)" />
                    </StackPanel>
                    <TextBlock x:Name="ResultadosTxt" Margin="4,4,0,12" FontSize="13" Foreground="{StaticResource FgMuted}" Visibility="Collapsed" />
                </Grid>

                <Grid x:Name="NovaArea" Grid.Row="2" Margin="0,0,0,10">
                    <TextBox x:Name="NovaBox" KeyDown="NovaBox_KeyDown" Padding="10,7" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NovaBox}" Text="Nova tarefa… (Enter)" />
                </Grid>

                <ListBox x:Name="Lista" Grid.Row="3" SelectionChanged="Lista_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Tarefa}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Accent}" Margin="6,2,0,0" ToolTip="Em foco"
                                                   Visibility="{Binding Foco, Converter={StaticResource BoolVis}}" />
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource PautaFg}" Margin="6,2,0,0" ToolTip="Tem anotação para reunião"
                                                   Visibility="{Binding TemPauta, Converter={StaticResource BoolVis}}" />
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE723;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource FgMuted}" Margin="6,2,0,0" ToolTip="Tem anexos"
                                                   Visibility="{Binding QtdAnexos, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="{Binding Titulo}" ToolTip="{Binding Titulo}" FontSize="13.5"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38" />
                                    </DockPanel>
                                    <TextBlock x:Name="Sub" Text="{Binding Subtitulo}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource FgMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Atrasada}" Value="True">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" x:Name="ListaVazia" Text="Nada por aqui." Foreground="{StaticResource FgMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasItems, ElementName=Lista, Converter={StaticResource BoolVisInv}}" />

                <!-- Rodapé: workspace atual (clique para trocar) e logs -->
                <Border Grid.Row="4" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="-14,8,-14,-12" Padding="8,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="LogsBtn" Style="{StaticResource IconButton}" Click="Logs_Click"
                                ToolTip="Ver logs do aplicativo">
                            <Grid>
                                <TextBlock Text="&#xE9D9;" />
                                <Ellipse x:Name="LogsAlerta" Width="7" Height="7" Fill="{StaticResource Danger}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="WorkspaceBtn" Style="{StaticResource TextButton}" Padding="8,5" HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left" Click="EscolherWorkspace_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource FgMuted}" />
                                <TextBlock x:Name="WorkspaceNome" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,2,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource FgMuted}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Detalhe ===== -->
        <TextBlock Grid.Column="1" Text="Selecione uma tarefa" Foreground="{StaticResource FgMuted}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding SelectedItem, ElementName=Lista, Converter={StaticResource BoolVisInv}}" />

        <!-- Soltar arquivos em qualquer ponto dos detalhes anexa à tarefa selecionada -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" AllowDrop="True"
                      PreviewDragEnter="Detalhe_DragOver" PreviewDragOver="Detalhe_DragOver"
                      PreviewDragLeave="Detalhe_DragLeave" PreviewDrop="Detalhe_Drop"
                      Visibility="{Binding SelectedItem, ElementName=Lista, Converter={StaticResource BoolVis}}">
            <StackPanel x:Name="Detalhe" Margin="32,22,32,28" DataContext="{Binding SelectedItem, ElementName=Lista}">

                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         TextWrapping="Wrap" Padding="8,6" />

                <!-- Status + ações -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                        <RadioButton Style="{StaticResource StatusRadio}" Content="A fazer" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.AFazer}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=AFazer}" />
                        <RadioButton Style="{StaticResource StatusRadio}" Content="Fazendo" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.Fazendo}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Fazendo}" />
                        <RadioButton Style="{StaticResource StatusRadio}" Content="Aguardando" GroupName="status"
                                     Tag="{x:Static local:StatusBrushConverter.Aguardando}"
                                     IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Aguardando}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"
                               Visibility="{Binding IsConcluida, Converter={StaticResource BoolVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0"
                                    Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                            <Button Style="{StaticResource TextButton}" Click="Focar_Click" ToolTip="Fixar no topo do painel"
                                    Visibility="{Binding Foco, Converter={StaticResource BoolVisInv}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Focar" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="TirarFoco_Click" Foreground="{StaticResource Accent}"
                                    Visibility="{Binding Foco, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77A;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Em foco · tirar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource AccentButton}" Click="Concluir_Click"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVisInv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Concluir" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Click="Reabrir_Click" BorderThickness="1"
                                Visibility="{Binding IsConcluida, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reabrir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Prazo e link -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Prazo (dd/mm)" />
                        <TextBox Text="{Binding PrazoTexto, UpdateSourceTrigger=LostFocus}" Padding="8,6" KeyDown="CampoSimples_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Link (chamado, PR, documento…)" />
                        <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="6,0,0,2"
                            Content="&#xE8A7;" ToolTip="Abrir link" Click="AbrirLink_Click" />
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Descrição" />
                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" MinHeight="110" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Padding="8,6" />

                <!-- Anexos (pasta da tarefa no workspace) -->
                <DockPanel Margin="0,18,0,6">
                    <StackPanel x:Name="AnexosAcoes" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Padding="10,3" FontSize="12" Click="Anexar_Click"
                                ToolTip="Escolher arquivos para mover para a pasta da tarefa">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE723;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Anexar…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Padding="10,3" FontSize="12" Click="AbrirPasta_Click"
                                ToolTip="Abrir a pasta da tarefa no Explorer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir pasta" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="AnexosTitulo" Text="Anexos" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Bottom" />
                </DockPanel>

                <Border x:Name="AnexosArea" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Padding="4"
                        Background="Transparent">
                    <Grid>
                        <ItemsControl x:Name="AnexosLista">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:AnexoItem}">
                                    <Border x:Name="Bd" CornerRadius="4" Padding="8,5" Background="Transparent" Cursor="Hand"
                                            ToolTip="Mostrar no Explorer" MouseLeftButtonUp="Anexo_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icone}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="13" Foreground="{StaticResource FgMuted}" Margin="0,1,10,0" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" FontSize="11.5" Margin="10,0,0,0"
                                                       Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBg}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AnexosDica" Margin="8,8" FontSize="12" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap"
                                   Text="Arraste arquivos para cá (eles são movidos; segure Ctrl para copiar) ou cole um print com Ctrl+V." />
                    </Grid>
                </Border>

                <!-- Sem workspace -->
                <Border x:Name="SemWorkspace" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Padding="12,10"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Escolher pasta…" FontSize="12"
                                Padding="10,4" Click="EscolherWorkspace_Click" />
                        <TextBlock Text="Escolha uma pasta de workspace para guardar os anexos: cada tarefa ganha uma subpasta."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Anotações (log) -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="Anotações" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NotaBox" Padding="8,6" KeyDown="NotaBox_KeyDown" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NotaBox}" Margin="10,0,0,0"
                               Text="O que aconteceu? (Enter registra · Ctrl+Enter registra para reunião)" />
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Registrar" Margin="6,0,0,0" Click="AdicionarNota_Click" />
                </Grid>

                <ItemsControl x:Name="Notas" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Anotacao}">
                            <Border x:Name="Bd" CornerRadius="5" Padding="10,7" Margin="0,2" Background="#0CFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Quando}" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,-4,-4,-4">
                                        <Button x:Name="PautaBtn" Style="{StaticResource IconButton}" Content="&#xE7C1;"
                                                FontSize="11" Padding="6" ToolTip="Levar para reunião (aparece na aba Pauta)"
                                                Click="PautaNota_Click" Opacity="0" />
                                        <Button x:Name="Del" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                FontSize="11" Padding="6" ToolTip="Excluir anotação"
                                                Click="ExcluirNota_Click" Opacity="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Opacity" Value="1" />
                                    <Setter TargetName="PautaBtn" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Pauta}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PautaBg}" />
                                    <Setter TargetName="PautaBtn" Property="Opacity" Value="1" />
                                    <Setter TargetName="PautaBtn" Property="Foreground" Value="{StaticResource PautaFg}" />
                                    <Setter TargetName="PautaBtn" Property="ToolTip" Value="Para reunião · clique quando já tiver falado" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rodapé -->
                <Grid Margin="0,24,0,0">
                    <TextBlock x:Name="CriadaEmTxt" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Click="Excluir_Click"
                            Foreground="{StaticResource Danger}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Excluir tarefa" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
