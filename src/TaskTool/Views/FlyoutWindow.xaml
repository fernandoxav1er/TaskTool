<Window x:Class="TaskTool.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:TaskTool.Models"
        Title="TaskTool" Width="424" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Margem para a sombra caber dentro da janela transparente -->
    <Grid x:Name="Raiz" Margin="12" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Deslize" />
        </Grid.RenderTransform>

        <!-- Sombra separada para não borrar o texto -->
        <Border CornerRadius="8" Background="{StaticResource FlyoutBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" Background="{StaticResource FlyoutBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Margin="20,14,10,6">
                    <TextBlock Text="Minhas tarefas" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Content="&#xE8A7;" ToolTip="Abrir aplicativo" Click="AbrirApp_Click" />
                </Grid>

                <!-- Tarefa em foco (fixada no topo) -->
                <Border Grid.Row="1" x:Name="FocoCard" Margin="16,2,16,10" CornerRadius="8" Padding="12,10,6,10"
                        Background="#1C4CC2FF" BorderBrush="#704CC2FF" BorderThickness="1" Cursor="Hand"
                        DataContext="{Binding Foco}" Visibility="{Binding Converter={StaticResource BoolVis}}"
                        MouseLeftButtonUp="FocoCard_MouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource CompleteButton}" Click="Concluir_Click"
                                VerticalAlignment="Top" Margin="0,17,12,0" ToolTip="Concluir" />

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                <TextBlock Text="EM FOCO" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Titulo}" ToolTip="{Binding Titulo}" FontSize="14.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="60" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource StatusPill}" Click="Status_Click" ToolTip="Clique para mudar o status">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="FocoDet" Text="{Binding Detalhe}" FontSize="11.5" Margin="4,0,0,0"
                                           Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" FontSize="12"
                                Content="&#xE77A;" ToolTip="Tirar o foco" Click="TirarFoco_Click" />
                    </Grid>
                </Border>

                <!-- Cadastro rápido -->
                <Grid Grid.Row="2" Margin="16,0,16,10">
                    <TextBox x:Name="NovaBox" KeyDown="NovaBox_KeyDown" Padding="10,7" FontSize="13" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NovaBox}"
                               Text="Nova tarefa… (Enter para adicionar)" />
                </Grid>

                <!-- Fila -->
                <ScrollViewer x:Name="Rolagem" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                    <ItemsControl x:Name="Lista" AllowDrop="True" Background="Transparent"
                                  DragOver="Lista_DragOver" Drop="Lista_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Tarefa}">
                                <Grid>
                                    <Border x:Name="Row" CornerRadius="6" Padding="8,8,6,8" Margin="0,1" Background="Transparent" Cursor="Hand"
                                            PreviewMouseLeftButtonDown="Row_MouseDown" PreviewMouseMove="Row_MouseMove"
                                            MouseLeftButtonUp="Row_MouseUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource CompleteButton}" Click="Concluir_Click"
                                                    VerticalAlignment="Top" Margin="0,1,12,0" ToolTip="Concluir" />

                                            <StackPanel Grid.Column="1">
                                                <!-- Até 3 linhas; passando disso corta com "…" e o tooltip mostra tudo -->
                                                <TextBlock Text="{Binding Titulo}" ToolTip="{Binding Titulo}" FontSize="13.5"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="57" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Button Style="{StaticResource StatusPill}" Click="Status_Click"
                                                            ToolTip="Clique para mudar o status">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="Det" Text="{Binding Detalhe}" FontSize="11.5" Margin="4,0,0,0"
                                                               Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="FocarBtn" Style="{StaticResource IconButton}" Content="&#xE718;" FontSize="12"
                                                        Padding="7" ToolTip="Focar nesta tarefa (fixa no topo)" Click="Focar_Click" Opacity="0" />
                                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="10" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"
                                                           Margin="2,0,4,0" Opacity="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Barrinha azul nas tarefas em andamento -->
                                    <Border x:Name="Barra" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,12"
                                            Background="{StaticResource Accent}" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBg}" />
                                        <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                                        <Setter TargetName="FocarBtn" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:StatusTarefa.Fazendo}">
                                        <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Atrasada}" Value="True">
                                        <Setter TargetName="Det" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Foco}" Value="True">
                                        <Setter TargetName="FocarBtn" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBg}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Vazio -->
                <StackPanel x:Name="Vazio" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               HorizontalAlignment="Center" Foreground="{StaticResource FgMuted}" />
                    <TextBlock Text="Nenhuma tarefa ativa" Margin="0,10,0,0" Foreground="{StaticResource FgMuted}" />
                </StackPanel>

                <!-- Rodapé -->
                <Border Grid.Row="4" Background="{StaticResource FlyoutFooterBg}" CornerRadius="0,0,7,7"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="20,6,8,6">
                    <Grid>
                        <TextBlock x:Name="Resumo" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FgMuted}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE81C;" ToolTip="Concluídas" Click="Concluidas_Click" />
                            <Button x:Name="OpcoesBtn" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Opções" Click="Opcoes_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
