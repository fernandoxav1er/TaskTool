<UserControl x:Class="TaskTool.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TaskTool.Views"
             PreviewKeyDown="View_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Recentes ===== -->
        <Border Background="{StaticResource FlyoutFooterBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Workspaces recentes" FontSize="12" Foreground="{StaticResource FgMuted}" Margin="8,0,0,8" />
                <ListBox x:Name="Recentes" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="MouseLeftButtonUp" Handler="Recente_Click" />
                            <EventSetter Event="KeyDown" Handler="Recente_KeyDown" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type v:WorkspaceRecente}">
                            <Grid x:Name="Raiz" Margin="0,4" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Nome" Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="3" Padding="5,0" Margin="8,2,0,0" Background="#334CC2FF" VerticalAlignment="Center"
                                                Visibility="{Binding Atual, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="atual" FontSize="10.5" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="Caminho" Text="{Binding Caminho}" ToolTip="{Binding Caminho}" FontSize="11.5"
                                               Foreground="{StaticResource FgMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    <TextBlock Text="Pasta não encontrada" FontSize="11.5" Foreground="{StaticResource Danger}" Margin="0,1,0,0"
                                               Visibility="{Binding Existe, Converter={StaticResource BoolVisInv}}" />
                                </StackPanel>
                                <Button x:Name="Remover" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                        Padding="6" VerticalAlignment="Center" ToolTip="Tirar da lista (não apaga nada)"
                                        Click="Remover_Click" Opacity="0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Raiz" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Remover" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Existe}" Value="False">
                                    <Setter TargetName="Nome" Property="Foreground" Value="{StaticResource FgMuted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Atual}" Value="True">
                                    <Setter TargetName="Remover" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SemRecentes" Grid.Row="1" Text="Nenhum workspace ainda." Foreground="{StaticResource FgMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- ===== Ações ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,14,32,24">
                <Button x:Name="VoltarBtn" Style="{StaticResource TextButton}" Padding="10,5" Margin="-10,0,0,14"
                        HorizontalAlignment="Left" Click="Voltar_Click" ToolTip="Voltar às tarefas (Esc)" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tarefas" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="TaskTool" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Aviso" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}"
                           Text="Um workspace é uma pasta: guarda o banco das tarefas e uma subpasta por tarefa com os anexos. Pode ficar no OneDrive." />

                <!-- Vale para "Criar" e para "Abrir pasta" quando a pasta ainda não tem banco -->
                <Border x:Name="TrazerArea" Margin="0,14,0,0" Padding="12,8" CornerRadius="6" Background="#1C4CC2FF"
                        BorderBrush="#704CC2FF" BorderThickness="1" Visibility="Collapsed">
                    <CheckBox x:Name="TrazerTarefas">
                        <TextBlock x:Name="TrazerTexto" TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <!-- Criar -->
                <TextBlock Text="Criar novo workspace" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nome" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox x:Name="NomeBox" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,6" Text="TaskTool" KeyDown="NomeBox_KeyDown" />
                    <TextBlock Grid.Row="2" Text="Local" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox x:Name="LocalBox" Grid.Row="2" Grid.Column="1" Padding="8,6" />
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource TextButton}" Content="Procurar…" Margin="6,0,0,0"
                            Click="Procurar_Click" />
                </Grid>
                <TextBlock x:Name="CriarPreview" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource FgMuted}"
                           TextTrimming="CharacterEllipsis" />
                <Button Style="{StaticResource AccentButton}" Content="Criar" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Padding="18,6" Click="Criar_Click" />

                <!-- Abrir -->
                <TextBlock Text="Abrir pasta como workspace" FontSize="15" FontWeight="SemiBold" Margin="0,28,0,6" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="12.5"
                           Text="Use uma pasta que já existe, por exemplo um workspace sincronizado pelo OneDrive em outro computador." />
                <Button Style="{StaticResource TextButton}" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Content="Abrir pasta…"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="Abrir_Click" />            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
